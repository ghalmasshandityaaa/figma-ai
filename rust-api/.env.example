# =============================================================================
# rust-api — environment configuration
#
# Usage:
#   cp .env.example .env
# `cargo run` auto-loads `.env` via dotenvy. Docker Compose does NOT read this
# file — it sets its own env vars in docker-compose.yml (in-network hostnames
# like `postgres`/`tempo` instead of `localhost`). Values below already match
# the *host-mapped* ports from docker-compose.yml, for the "infra in Docker,
# api/worker via `cargo run`" workflow — see DOCKER.md.
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:15432/app
DATABASE_MAX_CONNECTIONS=20

# -----------------------------------------------------------------------------
# Auth (PASETO v4.local)
# PASETO_KEY must decode to exactly 32 raw bytes, base64-encoded.
# Generate a new one with: openssl rand -base64 32
# -----------------------------------------------------------------------------
PASETO_KEY=RsiDWgpMTlbpAfKuYlnJtBsvADvCrIqcHZyDEle2OqM=
TOKEN_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry -> Tempo)
# -----------------------------------------------------------------------------
OTLP_ENDPOINT=http://localhost:14317
SERVICE_NAME=rust-api
RUST_LOG=info,sqlx=warn

# -----------------------------------------------------------------------------
# Security middleware
# -----------------------------------------------------------------------------
# Comma-separated allow-list, e.g. "https://app.example.com,https://admin.example.com".
# Empty = deny all cross-origin browser access (safe default).
CORS_ALLOWED_ORIGINS=

# Per-client-IP token bucket (keyed by X-Forwarded-For, falls back to peer addr).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=20

# Max request body size, in bytes. 1048576 = 1 MiB.
MAX_BODY_BYTES=1048576
